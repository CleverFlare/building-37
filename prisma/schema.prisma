// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model GlobalConfig {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  monthlyFee Int    @default(50)
}

model Owner {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  apartment        Apartment? @relation(fields: [apartmentId], references: [id])
  apartmentId      String?    @db.ObjectId
  name             String
  phone            String
  ownershipStartAt DateTime
  ownershipEndAt   DateTime?
  idPhoto          String?
  idPhotoKey       String?
  createdAt        DateTime   @default(now())
  updateAt         DateTime   @updatedAt
}

model Renter {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  apartment   Apartment? @relation(fields: [apartmentId], references: [id])
  apartmentId String?    @db.ObjectId
  name        String
  phone       String?
  rentStartAt DateTime
  rentEndAt   DateTime?
  idPhoto     String?
  idPhotoKey  String?
  createdAt   DateTime   @default(now())
  updateAt    DateTime   @updatedAt
}

model Apartment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  apartmentNumber Int
  owners          Owner[]
  renters         Renter[]
  status          Status   @default(vacant)
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String
  lastName     String
  fullName     String?
  username     String    @unique
  email        String    @unique
  passwordHash String
  otpHash      String? // hashed OTP
  otpExpires   DateTime?
  avatarUrl    String?
  avatarKey    String?
  role         Role
  createdAt    DateTime  @default(now())
  // updateAt     DateTime  @updatedAt
}

model MonthlyFee {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // === Apartment snapshot data ===
  apartmentNumber Int
  ownerName       String
  ownerPhone      String
  renterName      String?
  renterPhone     String?
  status          Status  @default(vacant)
  // ===

  paidAmount Int

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Balance {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  year  Int @unique
  month Int @unique

  amount Int
}

enum Status {
  vacant
  occupied
}

enum Role {
  admin
  moderator
  user
}
