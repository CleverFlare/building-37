DATABASE_URL=
PASSWORD_SALT=

DEFAULT_MONTHLY_FEE=

# used by createJwt
JWT_PRIVATE=

# Gmail account for nodemailer (use app password for production)
GMAIL_USER=
GMAIL_PASS=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Garage (S3-compatible storage) ---
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_ENDPOINT=

# --- MongoDB ---
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=
